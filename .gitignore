# .gitignore — PC-LWM

# ---------- Python ----------
__pycache__/
*.py[cod]
*.so
.Python
build/
dist/
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# ---------- MATLAB / Simulink ----------
*.slxc
slprj/
*.mexa64
*.mexw64
*.mexmaci64
*.asv
*.autosave

# ---------- 大文件（不入库，见 README）----------
